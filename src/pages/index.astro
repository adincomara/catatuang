---
import Layout from '../layouts/Layout.astro';
import LoginGate from '../components/LoginGate.astro';
import Navbar from '../components/Navbar.astro';
import HomeTab from '../components/HomeTab.astro';
import WalletsTab from '../components/WalletsTab.astro';
import TransactionsTab from '../components/TransactionsTab.astro';
import StatsTab from '../components/StatsTab.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PeriodModal from '../components/PeriodModal.astro';
import TransactionModal from '../components/TransactionModal.astro';
import WalletModal from '../components/WalletModal.astro';
import TransactionDetailModal from '../components/TransactionDetailModal.astro';
import BatchModal from '../components/BatchModal.astro';
---

<Layout title="CatatUang - Catatan Keuangan Pribadi">
  
  <!-- MANDATORY GOOGLE LOGIN GATE (ONLY DISPLAYED WHEN NOT LOGGED IN) -->
  <LoginGate />

  <!-- MAIN APP VIEW (LOCKED BEHIND GOOGLE AUTH) -->
  <div id="mainAppView" class="hidden min-h-screen flex flex-col bg-canvas-soft">
    
    <!-- Top Responsive Navbar -->
    <Navbar />

    <!-- Mode Arsip Notification Banner -->
    <div id="batchArchiveBanner" class="hidden bg-amber-400 text-ink font-bold px-4 py-2 text-xs flex items-center justify-between border-b border-amber-500 shadow-sm">
      <div class="flex items-center gap-2 truncate">
        <span>📁</span>
        <span class="truncate">Mode Arsip: <strong id="batchArchiveName"></strong> (Hanya Baca)</span>
      </div>
      <button
        type="button"
        id="btnExitBatchBanner"
        class="bg-black text-white px-2.5 py-1 rounded-xs text-[10px] sm:text-[11px] uppercase font-bold hover:bg-neutral-800 transition shrink-0 ml-2"
      >
        Kembali ke Buku Aktif ✕
      </button>
    </div>

    <!-- Main Container (1200px Grid as per design.md) -->
    <main class="flex-1 w-full max-w-[1200px] mx-auto px-4 lg:px-8 py-5 pb-24 lg:pb-12">
      <!-- 4 Core Tab Views -->
      <HomeTab />
      <WalletsTab />
      <TransactionsTab />
      <StatsTab />
    </main>

    <!-- Mobile Bottom Navigation (< 1024px) -->
    <MobileBottomNav />

    <!-- Interactive Modals / Bottom Sheets -->
    <PeriodModal />
    <TransactionModal />
    <WalletModal />
    <TransactionDetailModal />
    <BatchModal />

    <!-- Global Toast Feedback -->
    <div
      id="appToast"
      class="fixed bottom-20 lg:bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 px-4 py-2.5 bg-ink text-white text-xs font-bold rounded-xs shadow-flat-overlay flex items-center gap-2"
    >
    </div>

  </div>

  <!-- Client State & App Bootstrapper -->
  <script>
    import { initCatatUang } from '../scripts/app-client.js';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatatUang);
    } else {
      initCatatUang();
    }
  </script>
</Layout>
