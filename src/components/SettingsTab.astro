---
// Tab: Settings (Setelan & Ekspor)
---

<div id="tab-settings" class="tab-pane hidden space-y-6">
  
  <!-- Google Account Card -->
  <div class="bg-white border border-hairline-strong rounded-lg p-5 shadow-flat-subtle space-y-4">
    <div class="flex items-center justify-between border-b border-hairline pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Akun Google Aktif</h3>
      <span class="text-[10px] uppercase font-bold text-primary bg-mint-50 px-2 py-0.5 rounded-xs">Terkoneksi</span>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img id="settingsUserAvatar" src="/icon.svg" class="w-12 h-12 rounded-full border border-hairline object-cover" alt="User" />
        <div>
          <div id="settingsUserName" class="text-sm font-bold text-ink">Nama Pengguna</div>
          <div id="settingsUserEmail" class="text-xs text-muted">user@gmail.com</div>
        </div>
      </div>

      <button
        type="button"
        id="btnLogoutGoogle"
        class="btn-soft px-3.5 py-2 text-xs uppercase text-error hover:bg-red-50 border-error/30"
      >
        Keluar Akun
      </button>
    </div>

    <p class="text-[11px] text-muted">
      Catatan transaksi disimpan secara lokal di browser dan terisolasi khusus untuk akun Google di atas.
    </p>
  </div>

  <!-- Export & Backup Options -->
  <div class="bg-white border border-hairline-strong rounded-lg p-5 shadow-flat-subtle space-y-3">
    <div class="border-b border-hairline pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Ekspor & Cadangan Data</h3>
      <p class="text-[11px] text-muted">Unduh laporan transaksi dalam berbagai format</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
      <!-- Excel / Sheets Export -->
      <button
        type="button"
        id="btnExportXLSX"
        class="flex items-start gap-3 p-3.5 rounded-xs border border-hairline hover:border-primary hover:bg-mint-50 transition text-left"
      >
        <span class="text-2xl">📊</span>
        <div>
          <div class="text-xs font-bold text-ink">Ekspor ke Excel (.xlsx)</div>
          <div class="text-[11px] text-muted">Unduh laporan transaksi periode aktif untuk Google Sheets / Excel</div>
        </div>
      </button>

      <!-- CSV Export -->
      <button
        type="button"
        id="btnExportCSV"
        class="flex items-start gap-3 p-3.5 rounded-xs border border-hairline hover:border-primary hover:bg-mint-50 transition text-left"
      >
        <span class="text-2xl">📑</span>
        <div>
          <div class="text-xs font-bold text-ink">Ekspor ke CSV</div>
          <div class="text-[11px] text-muted">Format teks tabel sederhana dan fleksibel</div>
        </div>
      </button>

      <!-- JSON Backup -->
      <button
        type="button"
        id="btnBackupJSON"
        class="flex items-start gap-3 p-3.5 rounded-xs border border-hairline hover:border-primary hover:bg-mint-50 transition text-left"
      >
        <span class="text-2xl">💾</span>
        <div>
          <div class="text-xs font-bold text-ink">Cadangkan Data (JSON)</div>
          <div class="text-[11px] text-muted">Simpan seluruh dompet dan riwayat ke file cadangan</div>
        </div>
      </button>

      <!-- JSON Restore -->
      <label class="flex items-start gap-3 p-3.5 rounded-xs border border-hairline hover:border-primary hover:bg-mint-50 transition text-left cursor-pointer">
        <span class="text-2xl">📂</span>
        <div>
          <div class="text-xs font-bold text-ink">Pulihkan Cadangan (JSON)</div>
          <div class="text-[11px] text-muted">Impor data cadangan yang pernah Anda simpan</div>
        </div>
        <input type="file" id="inputRestoreJSON" accept=".json" class="hidden" />
      </label>
    </div>
  </div>

  <!-- App Controls & Management -->
  <div class="bg-white border border-hairline-strong rounded-lg p-5 shadow-flat-subtle space-y-3">
    <div class="border-b border-hairline pb-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-ink">Utilitas Aplikasi</h3>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
      <button
        type="button"
        id="btnLoadSampleData"
        class="btn-soft px-4 py-2.5 text-xs uppercase"
      >
        ✨ Muat Data Simulasi
      </button>
      <button
        type="button"
        id="btnOpenClientIdSettings"
        class="btn-soft px-4 py-2.5 text-xs uppercase"
      >
        ⚙️ Atur Google Client ID
      </button>
      <button
        type="button"
        id="btnResetAllUserData"
        class="btn-soft px-4 py-2.5 text-xs uppercase text-error border-error/30 hover:bg-red-50"
      >
        🗑️ Reset Data Akun Ini
      </button>
    </div>
  </div>

</div>
