---
// Component: BatchModal (Tutup Buku & Arsip Periode)
---

<div
  id="batchModal"
  class="modal-backdrop fixed inset-0 z-50 bg-black/50 flex items-end sm:items-center justify-center p-0 sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalBatchTitle"
>
  <div class="modal-panel bg-white border border-hairline-strong rounded-t-lg sm:rounded-lg max-w-lg w-full max-h-[90vh] flex flex-col overflow-hidden shadow-flat-overlay">
    
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-hairline flex items-center justify-between">
      <div>
        <h3 id="modalBatchTitle" class="text-sm sm:text-base font-extrabold text-ink uppercase tracking-wider">
          Kelola Batch & Tutup Buku
        </h3>
        <p class="text-xs text-muted mt-0.5">
          Arsipkan periode aktif ke Cloudflare D1 & mulai buku baru.
        </p>
      </div>
      <button
        type="button"
        class="btn-close-batch-modal text-muted hover:text-ink text-base p-1"
        aria-label="Tutup jendela batch"
      >
        ✕
      </button>
    </div>

    <!-- Scrollable Content -->
    <div class="p-4 sm:p-5 overflow-y-auto space-y-6">

      <!-- Section: Tutup Buku Baru Form -->
      <div class="bg-canvas-soft border border-hairline p-4 rounded-xs space-y-3">
        <div class="flex items-center justify-between">
          <label for="batchNameInput" class="text-xs font-bold uppercase tracking-wider text-ink">
            📦 Tutup Buku Periode Ini
          </label>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-xs bg-mint-50 text-primary border border-mint-200" id="batchCurrentPeriodBadge">
            Periode Aktif
          </span>
        </div>

        <div>
          <label for="batchNameInput" class="block text-[11px] font-medium text-body mb-1">
            Nama Batch / Judul Arsip
          </label>
          <input
            type="text"
            id="batchNameInput"
            placeholder="Contoh: Januari 2026, Ramadhan 1447H, Proyek A"
            class="w-full p-2.5 text-xs bg-white border border-hairline-strong rounded-xs text-ink focus:outline-none focus:border-primary"
          />
        </div>

        <div class="space-y-1.5 pt-1">
          <label class="block text-[11px] font-medium text-body">
            Pengaturan Saldo Dompet untuk Buku Baru:
          </label>
          <div class="space-y-1">
            <label class="flex items-center gap-2 text-xs text-ink cursor-pointer">
              <input type="radio" name="batchCarryBalance" value="reset" checked class="text-primary focus:ring-0" />
              <span>Reset semua saldo dompet ke <strong>Rp 0</strong> (Mulai dari nol)</span>
            </label>
            <label class="flex items-center gap-2 text-xs text-ink cursor-pointer">
              <input type="radio" name="batchCarryBalance" value="carry" class="text-primary focus:ring-0" />
              <span>Bawa sisa saldo akhir periode ini sebagai saldo awal buku baru</span>
            </label>
          </div>
        </div>

        <p class="text-[11px] text-muted leading-relaxed">
          ℹ️ Transaksi pada rentang tanggal ini akan disimpan permanen ke arsip D1 dan dibersihkan dari buku aktif.
        </p>

        <button
          type="button"
          id="btnArchiveBatchConfirm"
          class="w-full py-2.5 px-3 bg-primary hover:bg-primary-deep text-white text-xs font-bold rounded-xs uppercase tracking-wider transition shadow-sm"
        >
          Tutup Buku & Simpan ke D1
        </button>
      </div>

      <!-- Section: Saved Batches List -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-muted">
            Daftar Arsip Batch Tersimpan
          </h4>
          <button
            type="button"
            id="btnResetToLiveBook"
            class="text-[11px] font-bold text-primary hover:underline hidden"
          >
            ← Kembali ke Buku Aktif
          </button>
        </div>

        <div id="batchArchiveList" class="space-y-2">
          <!-- Injected dynamically -->
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="p-3 bg-canvas-soft border-t border-hairline flex items-center justify-end">
      <button
        type="button"
        class="btn-close-batch-modal btn-soft px-4 py-2 text-xs uppercase"
      >
        Tutup
      </button>
    </div>

  </div>
</div>
