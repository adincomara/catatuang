---
// Transaction Detail Modal
---

<div id="txDetailModal" class="modal-backdrop fixed inset-0 z-50 bg-black/40 flex items-end sm:items-center justify-center p-0 sm:p-4">
  <div class="modal-panel bg-white w-full sm:max-w-md rounded-t-lg sm:rounded-lg border border-hairline-strong shadow-flat-overlay overflow-hidden">
    
    <div class="p-4 border-b border-hairline flex items-center justify-between bg-canvas-soft">
      <h3 class="text-sm font-bold text-ink uppercase tracking-wider">Detail Transaksi</h3>
      <button type="button" class="btn-close-detail-modal text-muted hover:text-ink text-base p-1">✕</button>
    </div>

    <div class="p-5 space-y-4">
      <div class="flex items-center gap-3">
        <div id="detailTxIcon" class="w-12 h-12 rounded-xs bg-mint-50 flex items-center justify-center text-2xl border border-mint-200">
          🍔
        </div>
        <div>
          <div id="detailTxTitle" class="text-base font-bold text-ink">Judul Transaksi</div>
          <div id="detailTxCategory" class="text-xs text-muted">Kategori</div>
        </div>
      </div>

      <div class="p-4 bg-canvas-soft rounded-xs border border-hairline space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs text-muted">Nominal</span>
          <span id="detailTxAmount" class="text-base font-black text-ink">Rp 0</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-muted">Waktu</span>
          <span id="detailTxDate" class="text-xs font-semibold text-body">-</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-muted">Dompet</span>
          <span id="detailTxWallet" class="text-xs font-semibold text-body">-</span>
        </div>
        <div class="border-t border-hairline pt-2">
          <span class="text-[11px] text-muted block mb-1">Catatan:</span>
          <p id="detailTxNote" class="text-xs text-body italic">-</p>
        </div>
      </div>
    </div>

    <div class="p-4 bg-canvas-soft border-t border-hairline flex items-center justify-between">
      <button
        type="button"
        id="btnDeleteDetailTx"
        class="text-xs font-bold text-error uppercase hover:underline"
      >
        Hapus Transaksi
      </button>

      <div class="flex items-center gap-2">
        <button type="button" class="btn-close-detail-modal btn-soft px-3 py-2 text-xs uppercase">Tutup</button>
        <button type="button" id="btnEditDetailTx" class="btn-spruce px-4 py-2 text-xs uppercase">Ubah</button>
      </div>
    </div>

  </div>
</div>
