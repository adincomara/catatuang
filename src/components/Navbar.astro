---
// Responsive Top Navbar according to design.md
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-hairline px-3 sm:px-4 lg:px-8 py-2.5 sm:py-3">
  <div class="max-w-[1200px] mx-auto flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Left: Brand Wordmark -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <div class="w-7 h-7 sm:w-8 sm:h-8 bg-primary rounded-xs flex items-center justify-center text-white font-black text-xs sm:text-sm">
        CU
      </div>
      <div class="hidden md:block">
        <span class="text-base font-extrabold text-ink tracking-tight">Catat<span class="text-primary">Uang</span></span>
        <span class="ml-2 text-[10px] uppercase font-bold text-muted bg-mint-50 px-2 py-0.5 rounded-xs border border-hairline">Personal</span>
      </div>
    </div>

    <!-- Center: Custom Period Selector Pill & Sync Status -->
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0">
      <div class="flex items-center bg-canvas-soft border border-hairline rounded-xs p-0.5 sm:p-1">
        <button
          type="button"
          id="btnPrevPeriod"
          class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center text-muted hover:text-ink hover:bg-white rounded-xs transition text-xs sm:text-sm font-bold"
          title="Periode Sebelumnya"
        >
          ‹
        </button>

        <button
          type="button"
          id="btnOpenPeriodModal"
          class="flex items-center gap-1 sm:gap-1.5 px-1.5 sm:px-2.5 py-1 text-[11px] sm:text-xs font-bold text-ink hover:text-primary transition truncate max-w-[130px] sm:max-w-none"
        >
          <span class="text-xs sm:text-sm shrink-0">📅</span>
          <span id="labelCurrentPeriod" class="truncate">Bulan Ini</span>
          <span class="text-[8px] sm:text-[10px] text-muted shrink-0">▼</span>
        </button>

        <button
          type="button"
          id="btnNextPeriod"
          class="w-6 h-6 sm:w-7 sm:h-7 flex items-center justify-center text-muted hover:text-ink hover:bg-white rounded-xs transition text-xs sm:text-sm font-bold"
          title="Periode Berikutnya"
        >
          ›
        </button>
      </div>

      <!-- Cloudflare D1 Sync Indicator Badge -->
      <button
        type="button"
        id="syncStatusBadge"
        class="flex items-center gap-1.5 px-1.5 sm:px-2 py-1 text-[10px] font-bold rounded-xs bg-mint-50 border border-mint-200 text-primary transition shrink-0"
        title="Klik untuk cek status sinkronisasi D1"
      >
        <span id="syncStatusDot" class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
        <span id="syncStatusText" class="hidden sm:inline">100% Tersinkron</span>
      </button>
    </div>

    <!-- Right: Balance & User Status -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Total Balance Display (Hidden on small mobile screens < 640px) -->
      <div class="text-right hidden sm:block">
        <div class="text-[10px] uppercase font-bold text-muted tracking-wider">Saldo Periode</div>
        <div class="flex items-center justify-end gap-1.5">
          <span id="headerTotalBalance" class="text-sm lg:text-base font-black text-ink">Rp 0</span>
          <button id="btnToggleHideBalance" class="text-muted hover:text-ink transition p-0.5" title="Sembunyikan Saldo">
            👁️
          </button>
        </div>
      </div>

      <!-- Desktop Tab Links -->
      <nav class="hidden lg:flex items-center gap-1 border-l border-hairline pl-3 ml-1">
        <button data-tab="home" class="nav-tab-btn active px-3 py-1.5 text-xs font-bold text-primary bg-mint-50 rounded-xs uppercase tracking-wider">
          Beranda
        </button>
        <button data-tab="wallets" class="nav-tab-btn px-3 py-1.5 text-xs font-bold text-muted hover:text-ink rounded-xs uppercase tracking-wider">
          Dompet
        </button>
        <button data-tab="transactions" class="nav-tab-btn px-3 py-1.5 text-xs font-bold text-muted hover:text-ink rounded-xs uppercase tracking-wider">
          Riwayat
        </button>
        <button data-tab="stats" class="nav-tab-btn px-3 py-1.5 text-xs font-bold text-muted hover:text-ink rounded-xs uppercase tracking-wider">
          Laporan
        </button>
      </nav>

      <!-- Theme Toggle Button (Light/Dark) -->
      <button
        type="button"
        id="btnToggleTheme"
        class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-xs text-muted hover:text-ink hover:bg-canvas-soft transition border border-transparent hover:border-hairline text-sm"
        title="Ganti Mode Gelap / Terang"
        aria-label="Ganti Mode Tema"
      >
        <span id="themeToggleIcon">🌙</span>
      </button>

      <!-- User Profile Pic & Dropdown Menu -->
      <div class="relative flex items-center pl-1 sm:pl-2 border-l border-hairline">
        <button
          type="button"
          id="btnUserMenu"
          class="flex items-center gap-1 p-0.5 sm:p-1 hover:bg-canvas-soft rounded-xs transition border border-transparent hover:border-hairline"
          title="Menu Akun Google"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <img id="navUserAvatar" src="/icon.svg" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full border border-hairline object-cover" alt="Avatar" />
          <span class="text-[8px] sm:text-[9px] text-muted">▼</span>
        </button>

        <!-- Account Popover / Dropdown Menu -->
        <div
          id="userAccountDropdown"
          class="hidden absolute right-0 top-full mt-2 w-72 bg-white border border-hairline-strong rounded-lg shadow-flat-hover p-4 z-50 space-y-3"
        >
          <!-- User Profile Header -->
          <div class="flex items-start gap-3 border-b border-hairline pb-3">
            <img id="dropdownUserAvatar" src="/icon.svg" class="w-10 h-10 rounded-full border border-hairline object-cover shrink-0" alt="Avatar" />
            <div class="min-w-0 flex-1">
              <div id="dropdownUserName" class="text-xs font-bold text-ink truncate">Pengguna</div>
              <div id="dropdownUserEmail" class="text-[11px] text-muted truncate">user@gmail.com</div>
              <span class="inline-block mt-1 text-[9px] font-bold uppercase text-primary bg-mint-50 border border-mint-200 px-1.5 py-0.5 rounded-xs">
                ● Terkoneksi
              </span>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="space-y-1">
            <button
              type="button"
              id="btnDropdownTheme"
              class="w-full flex items-center justify-between px-2.5 py-2 text-xs font-semibold text-ink hover:bg-mint-50 hover:text-primary rounded-xs transition text-left"
            >
              <span class="flex items-center gap-2.5">
                <span id="dropdownThemeIcon">🌙</span>
                <span>Mode Tampilan</span>
              </span>
              <span id="dropdownThemeLabel" class="text-[10px] uppercase font-bold text-muted bg-canvas-soft px-1.5 py-0.5 rounded-xs">
                Terang
              </span>
            </button>
            <button
              type="button"
              id="btnDropdownExport"
              class="w-full flex items-center gap-2.5 px-2.5 py-2 text-xs font-semibold text-ink hover:bg-mint-50 hover:text-primary rounded-xs transition text-left"
            >
              <span>📊</span>
              <span>Ekspor Excel / Sheets (.xlsx)</span>
            </button>
            <button
              type="button"
              id="btnDropdownReset"
              class="w-full flex items-center gap-2.5 px-2.5 py-2 text-xs font-semibold text-muted hover:bg-red-50 hover:text-error rounded-xs transition text-left"
            >
              <span>🗑️</span>
              <span>Reset Data Akun Ini</span>
            </button>
          </div>

          <div class="border-t border-hairline pt-2">
            <button
              type="button"
              id="btnLogoutGoogle"
              class="w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-bold uppercase tracking-wider text-error bg-red-50 hover:bg-red-100 border border-error/30 rounded-xs transition"
            >
              <span>🚪</span>
              <span>Keluar Akun Google</span>
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</header>
